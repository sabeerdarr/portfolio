---
/** Freelance service preview card (homepage + services page). */
export interface Props {
  title: string;
  audience: string;
  problem: string;
  deliverables: string[];
  href: string;
  headingLevel?: 'h2' | 'h3';
}

const { title, audience, problem, deliverables, href, headingLevel: Heading = 'h3' } = Astro.props;
---

<article class="service-card">
  <Heading class="service-card__title">
    <a href={href}>{title}</a>
  </Heading>

  <dl class="service-card__facts">
    <dt>For</dt>
    <dd>{audience}</dd>
    <dt>Solves</dt>
    <dd>{problem}</dd>
  </dl>

  <h4 class="service-card__label">Typical deliverables</h4>
  <ul class="service-card__deliverables" role="list">
    {deliverables.map((item) => <li>{item}</li>)}
  </ul>

  <p class="service-card__link" aria-hidden="true">
    <span class="text-link">Service details</span>
  </p>
</article>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border: var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-raised);
    transition:
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .service-card:hover {
    border-color: var(--color-line-strong);
    box-shadow: var(--shadow-md);
  }

  .service-card__title {
    font-size: var(--text-h3);
  }

  .service-card__title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .service-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .service-card__facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    font-size: var(--text-small);
  }

  .service-card__facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-faint);
    padding-block-start: 0.2em;
  }

  .service-card__facts dd {
    margin: 0;
    color: var(--color-ink-secondary);
  }

  .service-card__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .service-card__deliverables {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
  }

  .service-card__deliverables li {
    padding: var(--space-1) var(--space-3);
    border: var(--border-hairline);
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    color: var(--color-ink-secondary);
  }

  .service-card__link {
    margin-block-start: auto;
  }
</style>
