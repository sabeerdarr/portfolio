---
import type { CollectionEntry } from 'astro:content';

/**
 * Case-study card used on the homepage. 'featured' renders a larger
 * editorial layout with the full meta grid; 'compact' is the
 * standard 2-up grid card. Both carry the hover border-stroke loop
 * (data-cardstroke): lime → cobalt → orange → lime, border-color
 * only, so nothing shifts on hover.
 */
export interface Props {
  project: CollectionEntry<'work'>;
  variant?: 'featured' | 'compact';
  /** Heading level so document outlines stay correct per page. */
  headingLevel?: 'h2' | 'h3';
  loading?: 'eager' | 'lazy';
}

const {
  project,
  variant = 'compact',
  headingLevel: Heading = 'h3',
  loading = 'lazy',
} = Astro.props;
const { data } = project;
const href = `/work/${project.id}/`;
const categories = data.categories ?? data.category;
---

<article class:list={['project-card', `project-card--${variant}`]} data-cardstroke>
  <a class="project-card__media-link" href={href} tabindex="-1" aria-hidden="true">
    <img
      class="project-card__image"
      src={data.coverImage}
      alt={data.coverAlt}
      width="1600"
      height="1000"
      loading={loading}
      decoding="async"
    />
  </a>

  <div class="project-card__body">
    <div class="project-card__main">
      <p class="project-card__meta">{categories.join(' · ')}</p>

      <Heading class="project-card__title">
        <a href={href} data-event="case-study-open">{data.title}</a>
      </Heading>

      <p class="project-card__summary">{data.summary}</p>

      {variant === 'compact' && <p class="project-card__outcome">{data.outcomeSummary}</p>}

      <p class="project-card__link" aria-hidden="true">
        <span class="text-link">Read the case study</span>
      </p>
    </div>

    {
      variant === 'featured' && (
        <dl class="project-card__details">
          <div>
            <dt>Role</dt>
            <dd>{data.role}</dd>
          </div>
          <div>
            <dt>Duration</dt>
            <dd>{data.duration}</dd>
          </div>
          <div>
            <dt>Platform</dt>
            <dd>{data.platform}</dd>
          </div>
          {data.keyContribution && (
            <div class="project-card__details-wide">
              <dt>Key contribution</dt>
              <dd>{data.keyContribution}</dd>
            </div>
          )}
        </dl>
      )
    }
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: var(--border-hairline) solid var(--color-border);
    background-color: var(--color-surface);
    overflow: hidden;
    transition: border-color var(--duration-hover) var(--ease);
  }

  /* Border-stroke loop on hover: color only, width never changes. */
  @media (hover: hover) {
    .project-card:hover {
      animation: cardStroke var(--duration-card-loop) var(--ease) infinite;
    }
  }

  @keyframes cardStroke {
    0% {
      border-color: var(--color-brand-mark);
    }
    33% {
      border-color: var(--color-accent-solid);
    }
    66% {
      border-color: var(--color-brand-orange);
    }
    100% {
      border-color: var(--color-brand-mark);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover {
      animation: none;
      border-color: var(--color-accent-solid);
    }
  }

  .project-card__media-link {
    display: block;
    border-block-end: var(--border-hairline) solid var(--color-border);
    background-color: var(--color-surface-2);
  }

  .project-card__image {
    inline-size: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .project-card__body {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    padding: var(--space-5);
    flex: 1;
  }

  .project-card__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1 1 16rem;
    min-width: 0;
  }

  .project-card__meta {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-accent);
  }

  .project-card__title {
    font-size: var(--text-h3);
  }

  /* Stretched link: the whole card is clickable, one tab stop. */
  .project-card__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .project-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
  }

  .project-card__summary {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .project-card__details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    align-content: start;
    gap: var(--space-4);
    margin: 0;
    flex: 1 1 14rem;
    padding-inline-start: var(--space-5);
    border-inline-start: var(--border-hairline) solid var(--color-border);
    font-size: var(--text-sm);
  }

  .project-card__details dt {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-block-end: var(--space-1);
  }

  .project-card__details dd {
    margin: 0;
    font-weight: 600;
    color: var(--color-text);
  }

  /* Long entries (key contribution) span the full row instead of
     being squeezed into one column. */
  .project-card__details-wide {
    grid-column: 1 / -1;
  }

  .project-card__outcome {
    margin-block-start: auto;
    padding-block-start: var(--space-4);
    border-block-start: var(--border-hairline) solid var(--color-border);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .project-card__link {
    margin-block-start: var(--space-2);
  }

  /* Featured variant: media beside content on wide screens, 16:7. */
  @media (min-width: 48rem) {
    .project-card--featured .project-card__image {
      aspect-ratio: 16 / 7;
    }

    .project-card--featured .project-card__body {
      padding: var(--space-6);
    }
  }
</style>
