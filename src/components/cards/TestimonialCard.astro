---
/**
 * Testimonial card. Render this ONLY with genuine, permission-cleared
 * quotes — never invent testimonials. While no real material exists,
 * pages show the honest "proof pending" state instead of this card.
 */
export interface Props {
  quote: string;
  name: string;
  /** Role and company, e.g. "Product Manager, [Company]". */
  attribution: string;
}

const { quote, name, attribution } = Astro.props;
---

<figure class="testimonial">
  <blockquote>
    <p>{quote}</p>
  </blockquote>
  <figcaption>
    <span class="testimonial__name">{name}</span>
    <span class="testimonial__attribution">{attribution}</span>
  </figcaption>
</figure>

<style>
  .testimonial {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border: var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-raised);
  }

  blockquote {
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-ink);
  }

  blockquote p::before {
    content: '\201C';
    color: var(--color-accent);
  }

  blockquote p::after {
    content: '\201D';
    color: var(--color-accent);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-small);
  }

  .testimonial__name {
    font-weight: 650;
  }

  .testimonial__attribution {
    color: var(--color-ink-faint);
  }
</style>
