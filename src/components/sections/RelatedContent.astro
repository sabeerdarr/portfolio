---
/**
 * Previous / next navigation between case studies or articles.
 */
export interface Props {
  previous?: { title: string; href: string } | undefined;
  next?: { title: string; href: string } | undefined;
  label?: string;
}

const { previous, next, label = 'More projects' } = Astro.props;
---

{
  (previous || next) && (
    <nav class="related" aria-label={label}>
      {previous ? (
        <a class="related__link" href={previous.href} rel="prev">
          <span class="related__direction">← Previous</span>
          <span class="related__title">{previous.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="related__link related__link--next" href={next.href} rel="next">
          <span class="related__direction">Next →</span>
          <span class="related__title">{next.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .related {
    display: grid;
    gap: var(--space-4);
    padding-block-start: var(--space-6);
    border-block-start: var(--border-hairline);
  }

  @media (min-width: 48rem) {
    .related {
      grid-template-columns: 1fr 1fr;
    }
  }

  .related__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .related__link:hover {
    border-color: var(--color-line-strong);
  }

  .related__link--next {
    text-align: end;
    align-items: flex-end;
  }

  .related__direction {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .related__title {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: 600;
    color: var(--color-ink);
  }
</style>
