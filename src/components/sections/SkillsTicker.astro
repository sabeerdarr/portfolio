---
/**
 * Full-bleed skills marquee. The item list is duplicated once so the
 * loop is seamless (translateX 0 → -50%); the duplicate copy is
 * aria-hidden since the first copy already announces the content via
 * the section's aria-label. Linear timing is the one deliberate
 * exception to the site's shared easing curve — a marquee that eases
 * reads as broken. Disabled under prefers-reduced-motion (both by the
 * global override and an explicit rule here).
 */
interface SkillItem {
  label: string;
  shape: 'circle' | 'square' | 'triangle';
}

const skills: SkillItem[] = [
  { label: 'Product design', shape: 'circle' },
  { label: 'Design systems', shape: 'square' },
  { label: 'AI SaaS', shape: 'triangle' },
  { label: 'B2B software', shape: 'circle' },
  { label: 'Mobile', shape: 'square' },
  { label: 'UX research', shape: 'triangle' },
  { label: 'Design leadership', shape: 'circle' },
  { label: 'Prototyping', shape: 'square' },
  { label: 'Design tokens', shape: 'triangle' },
  { label: 'Developer handoff', shape: 'circle' },
  { label: 'Accessibility', shape: 'square' },
];
---

<section class="ticker" aria-label="Skills">
  <div class="ticker__track" data-ticker>
    <div class="ticker__set">
      {
        skills.map((item) => (
          <span class="ticker__item">
            {item.label}
            <span
              class:list={['ticker__glyph', `ticker__glyph--${item.shape}`]}
              aria-hidden="true"
            />
          </span>
        ))
      }
    </div>
    <div class="ticker__set" aria-hidden="true">
      {
        skills.map((item) => (
          <span class="ticker__item">
            {item.label}
            <span
              class:list={['ticker__glyph', `ticker__glyph--${item.shape}`]}
              aria-hidden="true"
            />
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ticker {
    overflow: hidden;
    background-color: var(--color-accent-solid);
    color: var(--color-accent-ink);
    border-block-end: var(--border-hairline) solid var(--color-border);
  }

  .ticker__track {
    display: flex;
    width: max-content;
    padding-block: var(--space-4);
    animation: tickerScroll var(--duration-ticker) linear infinite;
  }

  .ticker__set {
    display: flex;
    flex-shrink: 0;
  }

  .ticker__item {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.4vw, 2.125rem);
    padding-inline-end: clamp(1.25rem, 2.4vw, 2.125rem);
    font-size: var(--text-h4);
    font-weight: 700;
    font-variation-settings: 'wdth' 108;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .ticker__glyph {
    display: block;
    inline-size: 9px;
    block-size: 9px;
    flex: none;
    background-color: var(--color-accent-ink);
  }

  .ticker__glyph--circle {
    border-radius: 50%;
  }

  .ticker__glyph--square {
    border-radius: 0;
  }

  .ticker__glyph--triangle {
    border-radius: 0;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  @keyframes tickerScroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      animation: none;
    }
  }
</style>
