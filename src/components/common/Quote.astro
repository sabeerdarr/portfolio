---
/** Editorial pull-quote for research verbatims and stakeholder quotes. */
export interface Props {
  /** Who said it, e.g. "Participant 4, usability session" — omit for anonymous. */
  attribution?: string;
}

const { attribution } = Astro.props;
---

<figure class="quote">
  <blockquote>
    <slot />
  </blockquote>
  {attribution && <figcaption>— {attribution}</figcaption>}
</figure>

<style>
  .quote {
    margin: 0;
    padding-inline-start: var(--space-5);
    border-inline-start: 3px solid var(--color-accent);
  }

  .quote blockquote {
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-ink);
  }

  .quote figcaption {
    margin-block-start: var(--space-3);
    font-size: var(--text-small);
    color: var(--color-ink-faint);
  }
</style>
