---
/**
 * Cursor-following glow blob — a soft, brand-coloured radial gradient
 * that trails the pointer with a smoothed (lerped) motion so the page
 * feels alive without being distracting.
 *
 * Guard rails:
 *  - renders only for mouse-style pointers (hover + fine), never touch
 *  - hidden entirely under prefers-reduced-motion
 *  - pointer-events: none, so it can never intercept interaction
 *  - sits BELOW the sticky header (z 150 < 200) so navigation stays crisp
 *  - colours come from the accent tokens, so it re-themes automatically
 */
---

<div class="cursor-blob" aria-hidden="true" data-cursor-blob></div>

<style>
  .cursor-blob {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 20%, transparent) 0%,
      color-mix(in srgb, var(--color-accent-strong) 11%, transparent) 40%,
      transparent 70%
    );
    filter: blur(45px);
    pointer-events: none;
    /* Above page content, below the sticky header (z 200). */
    z-index: 150;
    transform: translate(-50%, -50%);
    will-change: transform, opacity;
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
  }

  .cursor-blob.is-active {
    opacity: 1;
  }

  /* Only devices with a real cursor get the blob. */
  @media (hover: hover) and (pointer: fine) {
    .cursor-blob {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-blob {
      display: none;
    }
  }
</style>

<script>
  const blob = document.querySelector<HTMLElement>('[data-cursor-blob]');
  const wantsBlob =
    blob &&
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (blob && wantsBlob) {
    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let blobX = mouseX;
    let blobY = mouseY;
    let running = false;

    function frame() {
      // Lower value = slower, smoother trailing.
      const speed = 0.08;
      blobX += (mouseX - blobX) * speed;
      blobY += (mouseY - blobY) * speed;
      blob!.style.transform = `translate3d(${blobX}px, ${blobY}px, 0) translate(-50%, -50%)`;

      // Stop the loop once settled; pointermove restarts it. Keeps the
      // main thread idle when the cursor isn't moving.
      if (Math.abs(mouseX - blobX) + Math.abs(mouseY - blobY) > 0.3) {
        requestAnimationFrame(frame);
      } else {
        running = false;
      }
    }

    window.addEventListener(
      'pointermove',
      (event) => {
        mouseX = event.clientX;
        mouseY = event.clientY;
        blob.classList.add('is-active');
        if (!running) {
          running = true;
          requestAnimationFrame(frame);
        }
      },
      { passive: true }
    );

    // Fade out when the cursor leaves the window.
    document.documentElement.addEventListener('pointerleave', () => {
      blob.classList.remove('is-active');
    });
  }
</script>
