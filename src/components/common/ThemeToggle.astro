---
/**
 * Light/dark theme toggle. The current theme is stamped on <html>
 * as data-theme by the inline script in BaseLayout before paint,
 * so there is never a flash of the wrong theme. This button flips
 * it and persists the choice in localStorage.
 */
---

<button class="theme-toggle" type="button" data-theme-toggle aria-live="polite">
  <span class="theme-toggle__icon" aria-hidden="true">
    <svg
      class="theme-toggle__sun"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
      ></path>
    </svg>
    <svg
      class="theme-toggle__moon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </svg>
  </span>
  <span class="visually-hidden" data-theme-toggle-label>Switch to light theme</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: var(--border-hairline) solid var(--color-border);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color var(--duration-hover) var(--ease),
      border-color var(--duration-hover) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .theme-toggle__icon {
    display: grid;
  }

  .theme-toggle__icon svg {
    grid-area: 1 / 1;
    transition:
      opacity var(--duration-hover) var(--ease),
      transform var(--duration-hover) var(--ease);
  }

  /* Light theme shows the moon (the thing you can switch to). Dark
     is the site default, so the sun (switch-to-light icon) starts
     visible and only hides once data-theme="light" is stamped. */
  .theme-toggle__sun {
    opacity: 1;
  }

  .theme-toggle__moon {
    opacity: 0;
    transform: rotate(45deg) scale(0.6);
  }

  :global([data-theme='light']) .theme-toggle__sun {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }

  :global([data-theme='light']) .theme-toggle__moon {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  // Dark is the site default, so the "current" theme for an unset
  // attribute is dark — only an explicit data-theme="light" flips it.
  function currentTheme(): string {
    return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
  }

  function updateLabels() {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    document.querySelectorAll('[data-theme-toggle-label]').forEach((el) => {
      el.textContent = `Switch to ${next} theme`;
    });
  }

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* private browsing — theme simply won't persist */
      }
      updateLabels();
    });
  });

  updateLabels();
</script>
