---
/**
 * Horizontal-scroll image strip for case studies — used wherever a
 * visual belongs. Pass real images via `items`; while none exist,
 * `placeholderCount` renders labelled empty frames so the space for
 * imagery is reserved and obvious to fill.
 *
 * Accessibility: the strip is a labelled region, scrollable with the
 * keyboard (tabindex on the scroll container), and snap-scrolls
 * without hijacking. Wheel/trackpad and drag scrolling are native.
 */
export interface MediaItem {
  src: string;
  alt: string;
  caption?: string;
  /** Intrinsic size for layout stability; defaults suit screenshots. */
  width?: number;
  height?: number;
}

export interface Props {
  /** Real images. When present, placeholders are ignored. */
  items?: MediaItem[];
  /** Number of labelled placeholder frames to reserve. */
  placeholderCount?: number;
  /** What should eventually go here, e.g. "Component library overview". */
  placeholderLabel?: string;
  /** Accessible name for the strip. */
  label?: string;
  caption?: string;
}

const {
  items = [],
  placeholderCount = 3,
  placeholderLabel = 'Add image',
  label = 'Image gallery',
  caption,
} = Astro.props;

const hasItems = items.length > 0;
---

<figure class="media-scroller">
  <div class="media-scroller__track" role="region" aria-label={label} tabindex="0">
    {
      hasItems
        ? items.map((item) => (
            <figure class="media-scroller__item">
              <img
                src={item.src}
                alt={item.alt}
                width={item.width ?? 1440}
                height={item.height ?? 960}
                loading="lazy"
                decoding="async"
              />
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          ))
        : Array.from({ length: placeholderCount }).map((_, index) => (
            <div class="media-scroller__placeholder" aria-hidden="true">
              <span class="media-scroller__placeholder-index">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="media-scroller__placeholder-label">{placeholderLabel}</span>
              <span class="media-scroller__placeholder-hint">
                Drop an image here — see PROJECT_REPLACEMENT_GUIDE.md
              </span>
            </div>
          ))
    }
  </div>
  {
    !hasItems && (
      <p class="visually-hidden">
        Image gallery pending: {placeholderLabel}. Images will be added here.
      </p>
    )
  }
  {caption && <figcaption class="media-scroller__caption">{caption}</figcaption>}
  <p class="media-scroller__hint" aria-hidden="true">Scroll sideways →</p>
</figure>

<style>
  .media-scroller {
    margin: 0;
  }

  .media-scroller__track {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding-block-end: var(--space-3);
    /* Subtle affordance that content continues off-screen. */
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  .media-scroller__track:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .media-scroller__item {
    margin: 0;
    flex: 0 0 auto;
    inline-size: min(78%, 34rem);
    scroll-snap-align: start;
  }

  .media-scroller__item img {
    inline-size: 100%;
    block-size: auto;
    border: var(--border-hairline) solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
  }

  .media-scroller__item figcaption {
    margin-block-start: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .media-scroller__placeholder {
    flex: 0 0 auto;
    inline-size: min(78%, 34rem);
    aspect-ratio: 3 / 2;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1.5px dashed var(--color-border-strong);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    text-align: center;
  }

  .media-scroller__placeholder-index {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    color: var(--color-accent);
  }

  .media-scroller__placeholder-label {
    font-size: var(--text-h4);
    font-weight: 600;
    color: var(--color-text-muted);
    max-inline-size: 22ch;
  }

  .media-scroller__placeholder-hint {
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }

  .media-scroller__caption {
    margin-block-start: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .media-scroller__hint {
    margin-block-start: var(--space-2);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>
