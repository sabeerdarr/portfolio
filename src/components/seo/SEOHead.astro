---
import { site } from '@/config/site';

/**
 * Central metadata component rendered inside <head> by BaseLayout.
 * Handles title, description, canonical URL, Open Graph, Twitter
 * cards, robots directives, and JSON-LD structured data.
 */
export interface Props {
  /** Page title without the site suffix; the template adds it. */
  title?: string;
  /** Use the exact string as <title> with no template applied. */
  rawTitle?: string;
  description?: string;
  /** Path or absolute URL of the social sharing image. */
  socialImage?: string;
  /** og:type — 'article' for posts and case studies. */
  type?: 'website' | 'article' | 'profile';
  publishedDate?: Date;
  updatedDate?: Date;
  /** Set true to exclude a page from search indexes. */
  noindex?: boolean;
  /** Override the canonical URL (e.g. for syndicated articles). */
  canonicalUrl?: string;
  /** JSON-LD objects to embed. */
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  rawTitle,
  description = site.seo.defaultDescription,
  socialImage = site.seo.defaultSocialImage,
  type = 'website',
  publishedDate,
  updatedDate,
  noindex = false,
  canonicalUrl,
  structuredData = [],
} = Astro.props;

const pageTitle =
  rawTitle ?? (title ? site.seo.titleTemplate.replace('%s', title) : site.seo.defaultTitle);

// Canonical URLs always resolve against the production site URL —
// never localhost or a preview host.
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, site.url).href;
const imageUrl = new URL(socialImage, site.url).href;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{
  structuredData.map((schema) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
