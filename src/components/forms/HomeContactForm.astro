---
import { site } from '@/config/site';

/**
 * Home page's unified #contact form. Follows the same Formspree
 * pattern as ContactForm.astro (env-var-gated form ID, honest email
 * fallback when unset, fetch-based progressive enhancement,
 * honeypot, live-region status) but with a 3-button pill topic
 * selector (role="group" + aria-pressed) instead of a <select>.
 */
const formId = site.forms.contactFormId;
const configured = formId.length > 0;
const action = configured ? `https://formspree.io/f/${formId}` : '';

if (!configured && import.meta.env.DEV) {
  console.warn(
    '[contact] PUBLIC_FORMSPREE_CONTACT_FORM_ID is not set — the homepage contact form shows an email fallback.'
  );
}

const topics = ['A full-time role', 'A project', 'Something else'];
---

{
  configured ? (
    <form class="home-contact-form" method="POST" action={action} data-contact-form novalidate>
      <input type="hidden" name="_subject" value="New message via sabeerdarr.com" />
      {/* Honeypot — hidden from people and assistive tech; bots fill it. */}
      <p class="home-contact-form__hp" aria-hidden="true">
        <label>
          Leave this field empty
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      <p class="home-contact-form__field">
        <label for="cf-name">Name</label>
        <input id="cf-name" type="text" name="name" autocomplete="name" placeholder="Your name" />
      </p>

      <p class="home-contact-form__field">
        <label for="cf-email">Email</label>
        <input
          id="cf-email"
          type="email"
          name="email"
          autocomplete="email"
          placeholder="you@company.com"
          required
        />
      </p>

      <div class="home-contact-form__field">
        <span id="cf-topic-label">I'm contacting you about</span>
        <div class="chip-group" role="group" aria-labelledby="cf-topic-label" data-topic-group>
          {topics.map((topic, index) => (
            <button
              type="button"
              class="chip"
              data-topic-chip
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {topic}
            </button>
          ))}
        </div>
        <input type="hidden" name="topic" value={topics[0]} data-topic-value />
      </div>

      <p class="home-contact-form__field">
        <label for="cf-msg">Message</label>
        <textarea
          id="cf-msg"
          name="message"
          rows="5"
          placeholder="A few lines about the role or the project"
          required
        />
      </p>

      <p class="home-contact-form__privacy">
        Your details are used only to reply to this message and are processed by Formspree. See the{' '}
        <a href="/privacy">privacy notice</a>.
      </p>

      <p>
        <button class="btn btn--primary btn--large" type="submit">
          Send message
        </button>
      </p>

      <p class="home-contact-form__status" data-form-status role="status" aria-live="polite" />
    </form>
  ) : (
    <div class="home-contact-form__fallback">
      <p>The message form isn't connected yet. Email me directly instead:</p>
      <p>
        <a
          class="btn btn--primary"
          href={`mailto:${site.email}?subject=${encodeURIComponent('Message via sabeerdarr.com')}`}
        >
          Email {site.email}
        </a>
      </p>
    </div>
  )
}

<style>
  .home-contact-form,
  .home-contact-form__fallback {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: clamp(1.5rem, 3cqw, 2.5rem);
    border: var(--border-hairline) solid var(--color-border);
    background-color: var(--color-surface);
  }

  .home-contact-form__hp {
    position: absolute !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .home-contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .home-contact-form__field label,
  .home-contact-form__field > span {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: 700;
  }

  .home-contact-form__field input,
  .home-contact-form__field textarea {
    min-height: 3.25rem;
    padding: var(--space-3) var(--space-4);
    border: var(--border-hairline) solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg);
    font-size: var(--text-body);
  }

  .home-contact-form__field textarea {
    resize: vertical;
  }

  .home-contact-form__field input:focus-visible,
  .home-contact-form__field textarea:focus-visible {
    border-color: var(--color-accent);
  }

  .home-contact-form__field [data-invalid='true'] {
    border-color: var(--color-error);
  }

  .home-contact-form__privacy {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    max-width: 46em;
  }

  .home-contact-form__status {
    font-weight: 700;
  }

  .home-contact-form__status[data-state='success'] {
    color: var(--color-ok);
  }

  .home-contact-form__status[data-state='error'] {
    color: var(--color-error);
  }
</style>

<script>
  // Topic pill selector: one active chip at a time, mirrored into a
  // hidden field so it posts with the rest of the form.
  document.querySelectorAll<HTMLElement>('[data-topic-group]').forEach((group) => {
    const chips = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-topic-chip]'));
    const hiddenField = group.parentElement?.querySelector<HTMLInputElement>('[data-topic-value]');

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
        chip.setAttribute('aria-pressed', 'true');
        if (hiddenField) hiddenField.value = chip.textContent?.trim() ?? '';
      });
    });
  });

  // Progressive enhancement: client-side validation plus fetch
  // submission for inline success/error feedback, same pattern as
  // ContactForm.astro's employment/freelance forms.
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]');

    function validate(): boolean {
      let firstInvalid: HTMLElement | null = null;
      form
        .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')
        .forEach((field) => {
          const valid = field.checkValidity();
          field.dataset.invalid = String(!valid);
          field.setAttribute('aria-invalid', String(!valid));
          if (!valid && !firstInvalid) firstInvalid = field;
        });
      if (firstInvalid) {
        (firstInvalid as HTMLElement).focus();
        if (status) {
          status.dataset.state = 'error';
          status.textContent = 'Please complete the highlighted required fields.';
        }
        return false;
      }
      return true;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!validate() || !status) return;

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      status.dataset.state = '';
      status.textContent = 'Sending…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (response.ok) {
          status.dataset.state = 'success';
          status.textContent =
            "Thanks — your message is on its way. I'll reply within two working days.";
          form.reset();
        } else {
          throw new Error(`Formspree responded ${response.status}`);
        }
      } catch {
        status.dataset.state = 'error';
        status.textContent =
          'The message could not be sent. Please try again in a moment, or email me directly.';
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>
