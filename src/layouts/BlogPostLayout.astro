---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import TableOfContents from '@/components/common/TableOfContents.astro';
import RelatedContent from '@/components/sections/RelatedContent.astro';
import NewsletterForm from '@/components/forms/NewsletterForm.astro';
import ArticleCard from '@/components/cards/ArticleCard.astro';
import { formatDate, isoDate, slugify } from '@/utils/format';
import { readingTime } from '@/utils/readingTime';
import { blogPostingSchema, breadcrumbSchema } from '@/utils/schema';
import { site } from '@/config/site';

export interface Props {
  entry: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  previous?: { title: string; href: string } | undefined;
  next?: { title: string; href: string } | undefined;
  related?: CollectionEntry<'blog'>[];
}

const { entry, headings, previous, next, related = [] } = Astro.props;
const { data } = entry;
const url = new URL(`/writing/${entry.id}/`, site.url).href;
const rt = readingTime(entry.body ?? '');

const structuredData = [
  blogPostingSchema({
    title: data.title,
    description: data.description,
    url,
    image: data.socialImage ?? data.featuredImage ?? site.seo.defaultSocialImage,
    publishedDate: data.publishedDate,
    ...(data.updatedDate && { updatedDate: data.updatedDate }),
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Writing', path: '/writing' },
    { name: data.title, path: `/writing/${entry.id}/` },
  ]),
];
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.description}
  socialImage={data.socialImage ?? data.featuredImage ?? site.seo.defaultSocialImage}
  type="article"
  publishedDate={data.publishedDate}
  updatedDate={data.updatedDate}
  canonicalUrl={data.canonicalUrl}
  structuredData={structuredData}
>
  <article>
    <header class="post-hero">
      <div class="container container--narrow">
        <Breadcrumbs
          items={[
            { label: 'Home', href: '/' },
            { label: 'Writing', href: '/writing' },
            { label: data.title },
          ]}
        />

        <p class="post-hero__meta">
          <a class="post-hero__category" href={`/writing/category/${slugify(data.category)}/`}>
            {data.category}
          </a>
          <span aria-hidden="true">·</span>
          <time datetime={isoDate(data.publishedDate)}>{formatDate(data.publishedDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{rt.label}</span>
        </p>

        <h1 class="post-hero__title">{data.title}</h1>
        <p class="post-hero__description">{data.description}</p>

        {
          data.updatedDate && (
            <p class="post-hero__updated">
              Updated{' '}
              <time datetime={isoDate(data.updatedDate)}>{formatDate(data.updatedDate)}</time>
            </p>
          )
        }
      </div>

      {
        data.featuredImage && (
          <div class="container">
            <img
              class="post-hero__image"
              src={data.featuredImage}
              alt={data.featuredImageAlt ?? ''}
              width="1200"
              height="675"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        )
      }
    </header>

    <div class="container post-body">
      <aside class="post-body__sidebar">
        <TableOfContents headings={headings} />
      </aside>
      <div class="prose post-body__content">
        <slot />
      </div>
    </div>

    <footer class="container container--narrow post-footer">
      <div class="author-card">
        <p class="author-card__name">Written by {data.author}</p>
        <p class="author-card__bio">
          {site.title} helping teams turn complex requirements into clear, useful SaaS and mobile experiences.
          <a href="/work">See my work</a> or <a href="/contact">get in touch</a>.
        </p>
      </div>

      <NewsletterForm />

      {
        related.length > 0 && (
          <section aria-labelledby="related-heading">
            <h2 class="post-footer__related-heading" id="related-heading">
              Related articles
            </h2>
            <div class="post-footer__related">
              {related.map((article) => (
                <ArticleCard article={article} headingLevel="h3" />
              ))}
            </div>
          </section>
        )
      }

      <RelatedContent previous={previous} next={next} label="More articles" />
    </footer>
  </article>
</BaseLayout>

<style>
  .post-hero {
    padding-block-start: var(--space-6);
  }

  .post-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .post-hero__category {
    color: var(--color-accent);
    text-decoration: none;
  }

  .post-hero__category:hover {
    text-decoration: underline;
  }

  .post-hero__title {
    margin-block-start: var(--space-4);
  }

  .post-hero__description {
    margin-block-start: var(--space-4);
    font-size: var(--text-lead);
    color: var(--color-ink-secondary);
  }

  .post-hero__updated {
    margin-block-start: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }

  .post-hero__image {
    inline-size: 100%;
    margin-block-start: var(--space-6);
    border: var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }

  .post-body {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-8);
    justify-content: center;
  }

  @media (min-width: 64rem) {
    .post-body {
      grid-template-columns: 15rem minmax(0, var(--container-narrow));
      justify-content: center;
      align-items: start;
    }

    .post-body__sidebar {
      position: sticky;
      top: 5.5rem;
    }
  }

  .post-body__content {
    min-width: 0;
  }

  .post-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .author-card {
    padding: var(--space-5) var(--space-6);
    border-inline-start: 3px solid var(--color-accent);
    background-color: var(--color-surface);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .author-card__name {
    font-weight: 700;
  }

  .author-card__bio {
    margin-block-start: var(--space-2);
    font-size: var(--text-small);
    color: var(--color-ink-secondary);
  }

  .post-footer__related-heading {
    margin-block-end: var(--space-5);
  }

  .post-footer__related {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .post-footer__related {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
