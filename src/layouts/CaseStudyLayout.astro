---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import TableOfContents from '@/components/common/TableOfContents.astro';
import Callout from '@/components/common/Callout.astro';
import { formatDate, isoDate } from '@/utils/format';
import { creativeWorkSchema, breadcrumbSchema } from '@/utils/schema';
import { site } from '@/config/site';

/**
 * Shared case-study template. Ends on a two-card path block routing
 * to /about and /work (not prev/next case-study navigation) — the
 * 2026 redesign deliberately drops Trade-offs and per-project
 * testimonial sections, matching README's scope over Handoff's
 * component inventory.
 */
export interface Props {
  entry: CollectionEntry<'work'>;
  headings: MarkdownHeading[];
  previous?: { title: string; href: string } | undefined;
  next?: { title: string; href: string } | undefined;
}

const { entry, headings } = Astro.props;
const { data } = entry;
const url = new URL(`/work/${entry.id}/`, site.url).href;

const typeLabel: Record<string, string> = {
  client: 'Client project',
  internal: 'Internal product',
  employment: 'Professional work',
  concept: 'Concept case study',
};

const structuredData = [
  creativeWorkSchema({
    title: data.title,
    description: data.summary,
    url,
    image: data.socialImage ?? data.coverImage,
    publishedDate: data.publishedDate,
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Work', path: '/work' },
    { name: data.title, path: `/work/${entry.id}/` },
  ]),
];
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.summary}
  socialImage={data.socialImage ?? data.coverImage}
  type="article"
  publishedDate={data.publishedDate}
  updatedDate={data.updatedDate}
  structuredData={structuredData}
>
  <article>
    <header class="cs-hero">
      <div class="container">
        <Breadcrumbs
          items={[
            { label: 'Home', href: '/' },
            { label: 'Work', href: '/work' },
            { label: data.title },
          ]}
        />

        <p class="kicker cs-hero__kicker">
          {typeLabel[data.projectType]} · {(data.categories ?? data.category).join(' · ')}
        </p>
        <h1 class="cs-hero__title">{data.title}</h1>
        <p class="cs-hero__summary">{data.summary}</p>

        <dl class="cs-hero__meta">
          <div>
            <dt>Role</dt>
            <dd>{data.role}</dd>
          </div>
          {
            data.team && (
              <div>
                <dt>Team</dt>
                <dd>{data.team}</dd>
              </div>
            )
          }
          <div>
            <dt>Duration</dt>
            <dd>{data.duration}</dd>
          </div>
          <div>
            <dt>Platform</dt>
            <dd>{data.platform}</dd>
          </div>
          {
            data.industry && (
              <div>
                <dt>Industry</dt>
                <dd>{data.industry}</dd>
              </div>
            )
          }
          <div>
            <dt>Published</dt>
            <dd>
              <time datetime={isoDate(data.publishedDate)}>{formatDate(data.publishedDate)}</time>
            </dd>
          </div>
        </dl>

        {
          data.projectType === 'concept' && (
            <Callout variant="placeholder" title="Sample case study">
              <p>
                This is illustrative sample content demonstrating structure and depth. Replace it
                with a real project before sharing the site — see PROJECT_REPLACEMENT_GUIDE.md.
              </p>
            </Callout>
          )
        }
      </div>

      <div class="container container--wide">
        <img
          class="cs-hero__cover"
          src={data.coverImage}
          alt={data.coverAlt}
          width="1600"
          height="1000"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </header>

    <div class="container cs-body">
      <aside class="cs-body__sidebar">
        <TableOfContents headings={headings} title="In this case study" />
      </aside>
      <div class="prose cs-body__content">
        <slot />
      </div>
    </div>

    <footer class="container cs-footer">
      <div class="cs-path-cards" aria-label="Choose your path">
        <a class="cs-path-card" href="/about">
          <span class="cs-path-card__motif cs-path-card__motif--circle" aria-hidden="true"></span>
          <span class="cs-path-card__title">Hiring? See my experience and CV</span>
          <span class="cs-path-card__hint">Background, experience and how I work. → /about</span>
        </a>
        <a class="cs-path-card" href="/work">
          <span class="cs-path-card__motif cs-path-card__motif--square" aria-hidden="true"></span>
          <span class="cs-path-card__title">Have a project? See how I work</span>
          <span class="cs-path-card__hint">More case studies and what I worked on. → /work</span>
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .cs-hero {
    padding-block-start: var(--space-6);
  }

  .cs-hero__kicker {
    margin-block-start: var(--space-6);
  }

  .cs-hero__title {
    margin-block-start: var(--space-4);
    max-width: 20ch;
  }

  .cs-hero__summary {
    margin-block-start: var(--space-4);
    max-width: 46em;
    font-size: var(--text-lead);
    color: var(--color-text-muted);
  }

  .cs-hero__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--space-4) var(--space-5);
    margin-block: var(--space-6);
    padding-block: var(--space-5);
    border-block: var(--border-hairline) solid var(--color-border);
    font-size: var(--text-sm);
  }

  .cs-hero__meta dt {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-block-end: var(--space-1);
  }

  .cs-hero__meta dd {
    margin: 0;
    font-weight: 600;
  }

  .cs-hero__cover {
    inline-size: 100%;
    margin-block-start: var(--space-6);
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border: var(--border-hairline) solid var(--color-border);
    background-color: var(--color-surface);
  }

  .cs-body {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-8);
  }

  @media (min-width: 64rem) {
    .cs-body {
      grid-template-columns: 16rem minmax(0, 1fr);
      align-items: start;
    }

    .cs-body__sidebar {
      position: sticky;
      top: 5.5rem;
    }
  }

  .cs-body__content {
    min-width: 0;
  }

  .cs-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .cs-path-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    border: var(--border-hairline) solid var(--color-border);
  }

  .cs-path-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(1.5rem, 3.4cqw, 3rem);
    color: var(--color-text);
    text-decoration: none;
  }

  .cs-path-card + .cs-path-card {
    border-inline-start: var(--border-hairline) solid var(--color-border);
  }

  @media (max-width: 39.9375rem) {
    .cs-path-card + .cs-path-card {
      border-inline-start: 0;
      border-block-start: var(--border-hairline) solid var(--color-border);
    }
  }

  .cs-path-card:hover {
    background-color: var(--color-surface);
    text-decoration: none;
  }

  .cs-path-card__motif {
    display: block;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    background-color: var(--color-accent-solid);
  }

  .cs-path-card__motif--circle {
    border-radius: var(--radius-full);
  }

  .cs-path-card__motif--square {
    background-color: var(--color-text);
  }

  .cs-path-card__title {
    font-size: var(--text-h3);
    font-weight: 700;
    font-variation-settings: 'wdth' 108;
    line-height: var(--leading-snug);
    letter-spacing: -0.02em;
  }

  .cs-path-card__hint {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
