---
import '@/styles/global.css';
import { site } from '@/config/site';
import SEOHead from '@/components/seo/SEOHead.astro';
import SkipLink from '@/components/common/SkipLink.astro';
import SiteHeader from '@/components/navigation/SiteHeader.astro';
import SiteFooter from '@/components/navigation/SiteFooter.astro';
import CursorBlob from '@/components/common/CursorBlob.astro';
import type { Props as SEOProps } from '@/components/seo/SEOHead.astro';

/**
 * Base page shell: head metadata, theme bootstrapping, skip link,
 * header, main landmark, footer, and optional analytics.
 */
export interface Props extends SEOProps {}

const seoProps = Astro.props;
const analyticsToken = site.analytics.cloudflareToken;
const loadAnalytics = import.meta.env.PROD && analyticsToken.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Writing — ${site.name}`}
      href="/rss.xml"
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/miriam-libre-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Theme bootstrap: runs before paint so there is no flash of
         the wrong theme. Falls back to the OS preference. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          /* no storage access — the CSS media query fallback applies */
        }
        // Opt into section entry animations before first paint, only
        // when the browser can actually run them. No-JS and legacy
        // browsers never get the hidden starting state.
        if ('IntersectionObserver' in window) {
          document.documentElement.classList.add('js-reveal');
        }
      })();
    </script>

    <SEOHead {...seoProps} />

    {
      loadAnalytics && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </head>
  <body id="top">
    <SkipLink />
    <CursorBlob />
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // Section entry animations. The hidden starting state comes from
      // global.css (gated on html.js-reveal + motion preference); this
      // observer only ever ADDS visibility, so content can't get stuck
      // hidden — and as a belt-and-braces, everything is force-revealed
      // if the observer somehow never fires.
      // Keep in sync with the selector list in global.css.
      const REVEAL_SELECTOR = [
        'main section',
        'main .page-hero',
        'main aside',
        '.cs-hero',
        '.cs-body',
        '.cs-footer',
        '.post-hero',
        '.post-body',
        '.post-footer',
        '.gallery__item',
        '.contact-grid',
        '.resume__section',
      ].join(', ');

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = Array.from(document.querySelectorAll<HTMLElement>(REVEAL_SELECTOR));

      if (document.documentElement.classList.contains('js-reveal') && !reduceMotion) {
        let batchIndex = 0;
        let batchTime = 0;

        const observer = new IntersectionObserver(
          (entries) => {
            const now = performance.now();
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              // Stagger elements that arrive in the same moment.
              if (now - batchTime > 200) batchIndex = 0;
              batchTime = now;
              const el = entry.target as HTMLElement;
              el.style.transitionDelay = `${Math.min(batchIndex * 70, 280)}ms`;
              el.classList.add('is-revealed');
              observer.unobserve(el);
              batchIndex += 1;
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );

        targets.forEach((el) => observer.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-revealed'));
      }
    </script>
  </body>
</html>
