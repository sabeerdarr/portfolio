---
import '@/styles/global.css';
import { site } from '@/config/site';
import SEOHead from '@/components/seo/SEOHead.astro';
import SkipLink from '@/components/common/SkipLink.astro';
import SiteHeader from '@/components/navigation/SiteHeader.astro';
import SiteFooter from '@/components/navigation/SiteFooter.astro';
import type { Props as SEOProps } from '@/components/seo/SEOHead.astro';

/**
 * Base page shell: head metadata, theme bootstrapping, skip link,
 * header, main landmark, footer, and optional analytics.
 */
export interface Props extends SEOProps {}

const seoProps = Astro.props;
const analyticsToken = site.analytics.cloudflareToken;
const loadAnalytics = import.meta.env.PROD && analyticsToken.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Writing — ${site.name}`}
      href="/rss.xml"
    />
    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Theme bootstrap: runs before paint so there is no flash of
         the wrong theme. Falls back to the OS preference. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          /* no storage access — the CSS media query fallback applies */
        }
      })();
    </script>

    <SEOHead {...seoProps} />

    {
      loadAnalytics && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </head>
  <body id="top">
    <SkipLink />
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
