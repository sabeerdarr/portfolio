---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import Callout from '@/components/common/Callout.astro';
import AvailabilityBadge from '@/components/common/AvailabilityBadge.astro';
import SocialLinks from '@/components/common/SocialLinks.astro';
import { site } from '@/config/site';
import { profilePageSchema, breadcrumbSchema } from '@/utils/schema';
import { resumePdfExists } from '@/utils/resume';

const hasResume = resumePdfExists();

const capabilities = [
  {
    area: 'Research',
    items: [
      'User interviews',
      'Usability testing',
      'Heuristic evaluation',
      'Survey design',
      'Analytics review',
    ],
  },
  {
    area: 'Design',
    items: [
      'User flows',
      'Information architecture',
      'Wireframing',
      'Interface design',
      'Interaction design',
    ],
  },
  {
    area: 'Systems',
    items: [
      'Design tokens',
      'Component libraries',
      'Documentation',
      'Accessibility standards',
      'Figma architecture',
    ],
  },
  {
    area: 'Collaboration',
    items: [
      'Developer handoff',
      'Design critique',
      'Workshop facilitation',
      'Async communication',
      'Roadmap input',
    ],
  },
];

const timeline = [
  {
    period: '[Year]–present',
    role: '[Current role title]',
    place: '[Company or independent practice]',
    note: 'PLACEHOLDER — replace with a one-line summary of what you own and shipped in this role.',
  },
  {
    period: '[Year]–[Year]',
    role: '[Previous role title]',
    place: '[Company]',
    note: 'PLACEHOLDER — replace with the scope of the role and one concrete achievement.',
  },
  {
    period: '[Year]–[Year]',
    role: '[Earlier role or education]',
    place: '[Company or institution]',
    note: 'PLACEHOLDER — replace with how this shaped your design practice.',
  },
];

const structuredData = [
  profilePageSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ]),
];
---

<BaseLayout
  title="About"
  description={`About ${site.name} — a UI/UX and product designer focused on clear, evidence-based design for SaaS and mobile products.`}
  structuredData={structuredData}
>
  <div class="container">
    <header class="page-hero">
      <p class="kicker">About</p>
      <h1>Design is a decision-making discipline</h1>
      <div class="about-intro">
        <div class="about-intro__text">
          <p>
            I'm {site.name}, a UI/UX designer working with product teams on SaaS and mobile
            experiences. My job, as I see it: reduce the gap between what a product demands of
            people and what people can comfortably give it.
          </p>
          <Callout variant="placeholder" title="Personal bio to replace">
            <p>
              Replace this paragraph with your real background: how you came to design, the kinds of
              products you've worked on, and what you're known for. Two or three sentences, first
              person, no buzzwords.
            </p>
          </Callout>
        </div>
        <figure class="about-intro__photo">
          <img
            src="/images/profile/profile-placeholder.svg"
            alt="Placeholder for a portrait photograph of Sabeer Darr"
            width="640"
            height="800"
            loading="eager"
          />
          <figcaption>
            Replace with a real photo — 640×800px, see PROJECT_REPLACEMENT_GUIDE.md
          </figcaption>
        </figure>
      </div>
    </header>

    <section class="section" aria-labelledby="philosophy-heading">
      <SectionHeading
        kicker="Philosophy"
        title="What I believe about design work"
        id="philosophy-heading"
      />
      <div class="philosophy">
        <div>
          <h3>Evidence beats taste</h3>
          <p>
            Taste breaks ties; evidence sets direction. When a decision is high-risk, I'd rather
            spend three days testing than three weeks debating.
          </p>
        </div>
        <div>
          <h3>Users are the point, business is the context</h3>
          <p>
            Advocacy for users only works when it's paired with an honest understanding of what the
            business needs the product to do. Good design serves both or it ships as neither.
          </p>
        </div>
        <div>
          <h3>Systems over heroics</h3>
          <p>
            A brilliant screen matters less than a coherent product. I invest in tokens, patterns,
            and documentation because consistency is a user-facing feature.
          </p>
        </div>
        <div>
          <h3>Writing is design work</h3>
          <p>
            Interface copy, decision records, handoff notes — the words are part of the product and
            part of the process. Clear writing is how remote teams stay aligned.
          </p>
        </div>
      </div>
    </section>

    <section class="section section--bordered" aria-labelledby="capabilities-heading">
      <SectionHeading
        kicker="Capabilities"
        title="What I actually do day to day"
        id="capabilities-heading"
      >
        Tools change; these are the skills underneath. (For the curious: mostly Figma for design and
        prototyping, plus whatever research, whiteboard, and ticketing tools your team already
        uses.)
      </SectionHeading>
      <div class="capabilities">
        {
          capabilities.map((group) => (
            <div class="capabilities__group">
              <h3>{group.area}</h3>
              <ul role="list">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="remote-heading">
      <SectionHeading
        kicker="Working style"
        title="Built for remote collaboration"
        id="remote-heading"
      />
      <div class="remote-grid">
        <div>
          <h3>Async first</h3>
          <p>
            Decisions and rationale live in writing — Figma comments, decision docs, recorded
            walkthroughs — so work moves while teammates sleep.
          </p>
        </div>
        <div>
          <h3>Overlap where it counts</h3>
          <p>
            Based in {site.timeZone}. {site.timeZoneOverlap} Critiques and decision meetings get scheduled
            in shared hours; everything else doesn't need a meeting.
          </p>
        </div>
        <div>
          <h3>Visible progress</h3>
          <p>
            Work-in-progress is shared early and often. You'll never wonder what I've been doing for
            two weeks.
          </p>
        </div>
      </div>
    </section>

    <section class="section section--bordered" aria-labelledby="timeline-heading">
      <SectionHeading kicker="Experience" title="Where I've worked" id="timeline-heading" />
      <Callout variant="placeholder" title="Timeline placeholders">
        <p>Replace every entry below with your real history — same fields, real facts.</p>
      </Callout>
      <ol class="timeline" role="list">
        {
          timeline.map((entry) => (
            <li class="timeline__entry">
              <p class="timeline__period">{entry.period}</p>
              <div>
                <h3>
                  {entry.role} · <span class="timeline__place">{entry.place}</span>
                </h3>
                <p>{entry.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section" aria-labelledby="personal-heading">
      <SectionHeading kicker="Off the clock" title="Beyond the work" id="personal-heading" />
      <Callout variant="placeholder" title="Personal interests to replace">
        <p>
          Add two or three genuine interests here — the point is to be a person, not a persona.
          Delete the section entirely if you'd rather keep the site strictly professional.
        </p>
      </Callout>
    </section>

    <aside class="about-cta">
      <AvailabilityBadge variant="full" />
      <h2>Currently: {site.availability.message}</h2>
      <div class="about-cta__actions">
        <a class="btn btn--primary" href="/contact">Get in touch</a>
        <a class="btn btn--secondary" href="/work">See the work</a>
        {
          hasResume ? (
            <a class="btn btn--ghost" href={site.resumePath} data-event="resume-download" download>
              Download resume
            </a>
          ) : (
            <a class="btn btn--ghost" href="/resume">
              View resume
            </a>
          )
        }
      </div>
      <div class="about-cta__social">
        <p class="kicker">Elsewhere</p>
        <SocialLinks variant="inline" />
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-8) var(--space-6);
  }

  .page-hero h1 {
    margin-block-start: var(--space-4);
    max-width: 22ch;
  }

  .about-intro {
    display: grid;
    gap: var(--space-6);
    margin-block-start: var(--space-6);
  }

  @media (min-width: 48rem) {
    .about-intro {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .about-intro__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    font-size: var(--text-lead);
    color: var(--color-ink-secondary);
  }

  .about-intro__photo {
    margin: 0;
    max-width: 20rem;
  }

  .about-intro__photo img {
    inline-size: 100%;
    border: var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }

  .about-intro__photo figcaption {
    margin-block-start: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }

  .section--bordered {
    border-block: var(--border-hairline);
    background-color: var(--color-surface);
  }

  .philosophy,
  .remote-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-6);
  }

  .philosophy h3,
  .remote-grid h3 {
    font-size: var(--text-h4);
    margin-block-end: var(--space-2);
  }

  .philosophy p,
  .remote-grid p {
    font-size: var(--text-small);
    color: var(--color-ink-secondary);
  }

  .capabilities {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-6);
  }

  .capabilities__group h3 {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-block-end: var(--space-3);
  }

  .capabilities__group ul {
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-small);
    color: var(--color-ink-secondary);
  }

  .timeline {
    margin-block-start: var(--space-6);
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .timeline__entry {
    display: grid;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-5);
    border-block-end: var(--border-hairline);
  }

  @media (min-width: 48rem) {
    .timeline__entry {
      grid-template-columns: 10rem minmax(0, 1fr);
    }
  }

  .timeline__period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
    padding-block-start: 0.35rem;
  }

  .timeline__entry h3 {
    font-size: var(--text-h4);
  }

  .timeline__place {
    color: var(--color-ink-faint);
    font-weight: 400;
  }

  .timeline__entry p:not(.timeline__period) {
    margin-block-start: var(--space-2);
    font-size: var(--text-small);
    color: var(--color-ink-secondary);
  }

  .about-cta {
    margin-block: var(--space-7);
    padding: var(--space-7) var(--space-6);
    border: var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .about-cta h2 {
    font-size: var(--text-h3);
    max-width: 30ch;
  }

  .about-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .about-cta__social {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-block-start: var(--space-3);
  }
</style>
