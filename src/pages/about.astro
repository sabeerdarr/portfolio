---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AvailabilityBadge from '@/components/common/AvailabilityBadge.astro';
import { site } from '@/config/site';
import { profilePageSchema, breadcrumbSchema } from '@/utils/schema';

/**
 * About Me — the CV page. Content mirrors the downloadable PDF
 * (public/resume/sabeer-darr-resume.pdf); keep the two in sync when
 * updating either. The phone number is intentionally left off the
 * web page (it's in the PDF) to avoid scraping and spam.
 */

const mailto = `mailto:${site.email}?subject=${encodeURIComponent("Let's chat — via sabeerdarr.com")}`;

const coreSkills = [
  'Product Design',
  'UX Strategy',
  'Interaction Design',
  'Design Systems',
  'Design Leadership',
  'Figma',
  'Prototyping',
  'User Flows',
  'Wireframing',
  'Design Tokens',
  'Component Libraries',
  'Accessibility',
  'Design Quality Assurance',
  'Stakeholder Management',
  'Cross-functional Collaboration',
  'AI SaaS',
  'B2B SaaS',
  'Responsive Web and Mobile Design',
];

interface Role {
  company: string;
  title: string;
  period: string;
  location: string;
  bullets: string[];
  caseStudy?: { label: string; href: string };
}

const experience: Role[] = [
  {
    company: 'GrantAssistant.ai',
    title: 'Product Design Lead',
    period: 'September 2023 – Present',
    location: 'Lahore, Pakistan',
    bullets: [
      'Lead end-to-end product design for an AI-powered grant-management platform serving nonprofits, INGOs, and international development organizations.',
      'Own complex workflows from problem definition and user flows through prototyping, developer handoff, implementation review, and continuous improvement.',
      'Established and maintained a design system with 50+ reusable components, enabling consistent product delivery across a team of 10+ designers and engineers.',
      'Defined design tokens, typography, color, spacing, layout standards, component states, and reusable interaction patterns in Figma.',
      'Created component documentation and usage guidelines; partnered with engineers to align Figma components with the production front-end library and improve implementation quality.',
      'Audited product experiences, resolved visual and interaction inconsistencies, and standardized patterns across core workflows.',
      'Led design for AI-assisted workflows covering grant discovery, proposal development, collaboration, compliance, and document management.',
      'Collaborate with product managers, engineers, executives, and stakeholders to define requirements, guide features from discovery through release, and maintain usability, accessibility, consistency, and product quality.',
    ],
    caseStudy: { label: 'Read the Grant Assistant case study', href: '/work/grant-assistant/' },
  },
  {
    company: 'OneByte',
    title: 'Lead UI/UX Designer',
    period: 'July 2021 – September 2024',
    location: 'Lahore, Pakistan',
    bullets: [
      'Led a multidisciplinary team of UI/UX and graphic designers delivering digital products for internal teams and external clients.',
      'Provided design direction across SaaS products, e-commerce applications, mobile apps, television applications, games, responsive websites, and brand experiences.',
      'Translated business and customer requirements into user flows, wireframes, interactive prototypes, and production-ready interfaces.',
      'Managed workload allocation, design reviews, stakeholder communication, and delivery planning across concurrent projects.',
      'Collaborated with clients, product stakeholders, and engineers to move product concepts from requirements through implementation.',
      'Contributed to G2-recognized product experiences for usability and ease of administration.',
    ],
    caseStudy: { label: 'Read the Olive case study', href: '/work/olive/' },
  },
  {
    company: 'JinnByte',
    title: 'Design Team Lead',
    period: 'July 2020 – July 2021',
    location: 'Lahore, Pakistan',
    bullets: [
      'Progressed from Senior UI/UX Designer to Design Team Lead after seven months, reflecting increased responsibility for design direction and team delivery.',
    ],
  },
  {
    company: 'JinnByte',
    title: 'Senior UI/UX Designer',
    period: 'January 2020 – July 2020',
    location: 'Lahore, Pakistan',
    bullets: [],
  },
];

const additionalExperience = [
  {
    company: 'Intellectual Bunch Ltd',
    title: 'UI/UX Designer',
    period: 'November 2018 – January 2020',
    location: 'Lahore, Pakistan',
  },
  {
    company: 'Splendrz',
    title: 'UI/UX Designer',
    period: 'January 2017 – October 2018',
    location: 'Lahore, Pakistan',
  },
  {
    company: 'Devclones',
    title: 'UI/UX Designer and Game Developer',
    period: 'November 2014 – December 2016',
    location: 'Lahore, Pakistan',
  },
  {
    company: 'Event Bazar',
    title: 'Co-Founder',
    period: 'October 2015 – April 2016',
    location: 'LUMS Center for Entrepreneurship, Lahore',
  },
  {
    company: 'PUCIT ACM',
    title: 'Graphic Designer',
    period: 'October 2013 – June 2015',
    location: 'Lahore, Pakistan',
  },
];

const structuredData = [
  profilePageSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'About Me', path: '/about' },
  ]),
];
---

<BaseLayout
  title="About Me"
  description={`${site.name} — Product Design Lead with 10+ years across AI SaaS, B2B software, e-commerce, and consumer applications. Full CV: experience, skills, education.`}
  structuredData={structuredData}
>
  <div class="container container--narrow cv">
    <header class="cv__header">
      <p class="kicker">About Me</p>
      <h1>{site.name}</h1>
      <p class="cv__headline">Product Design Lead · AI SaaS · UX Strategy · Design Systems</p>
      <ul class="cv__contact" role="list">
        <li>{site.location}</li>
        <li><a href={mailto}>{site.email}</a></li>
        <li><a href="https://www.linkedin.com/in/sabeerdarr" rel="me noopener">LinkedIn</a></li>
      </ul>
      <div class="cv__actions">
        <a class="btn btn--primary" href={site.resumePath} data-event="resume-download" download>
          Download CV
        </a>
        <a class="btn btn--secondary" href={mailto} data-event="hire-email">Let's chat</a>
      </div>
      <p class="cv__badge"><AvailabilityBadge variant="full" /></p>
    </header>

    <section class="cv__section" aria-labelledby="summary-heading">
      <h2 id="summary-heading">Summary</h2>
      <p>
        Product Design Lead with 10+ years of experience designing and scaling web, mobile, and
        cross-platform products across AI SaaS, B2B software, e-commerce, and consumer applications.
        Leads end-to-end product design for complex workflows, from problem definition and user
        flows to prototyping, developer handoff, implementation review, and continuous improvement.
        Combines a computer science foundation with UX strategy, interaction design, design systems,
        design leadership, and cross-functional delivery.
      </p>
    </section>

    <section class="cv__section" aria-labelledby="skills-heading">
      <h2 id="skills-heading">Core skills</h2>
      <ul class="cv__skills" role="list">
        {coreSkills.map((skill) => <li>{skill}</li>)}
      </ul>
    </section>

    <section class="cv__section" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Professional experience</h2>
      {
        experience.map((role) => (
          <article class="cv__role">
            <div class="cv__role-head">
              <h3>
                {role.company} · <span class="cv__role-title">{role.title}</span>
              </h3>
              <p class="cv__period">
                {role.period} · {role.location}
              </p>
            </div>
            {role.bullets.length > 0 && (
              <ul>
                {role.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
            {role.caseStudy && (
              <p class="cv__case-link">
                <a class="text-link" href={role.caseStudy.href}>
                  {role.caseStudy.label}
                </a>
              </p>
            )}
          </article>
        ))
      }
    </section>

    <section class="cv__section" aria-labelledby="additional-heading">
      <h2 id="additional-heading">Additional experience</h2>
      <ul class="cv__additional" role="list">
        {
          additionalExperience.map((role) => (
            <li>
              <span class="cv__additional-role">
                {role.company} · {role.title}
              </span>
              <span class="cv__period">
                {role.period} · {role.location}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cv__section" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <p>
        <strong>University of the Punjab</strong> — Bachelor of Science in Computer Science, 2011–2015
      </p>
    </section>

    <section class="cv__section" aria-labelledby="certification-heading">
      <h2 id="certification-heading">Certification</h2>
      <p>User Experience: The Beginner's Guide — Interaction Design Foundation</p>
    </section>

    <section class="cv__section" aria-labelledby="languages-heading">
      <h2 id="languages-heading">Languages</h2>
      <p>English · Urdu</p>
    </section>

    <aside class="cv__footer-cta">
      <h2>Sound like a fit for your team?</h2>
      <div class="cv__actions">
        <a class="btn btn--primary" href={site.resumePath} data-event="resume-download" download>
          Download CV
        </a>
        <a class="btn btn--secondary" href={mailto} data-event="hire-email">Let's chat</a>
        <a class="btn btn--ghost" href="/work">See the work</a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .cv {
    padding-block: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .cv__header h1 {
    margin-block-start: var(--space-4);
  }

  .cv__headline {
    margin-block-start: var(--space-2);
    font-size: var(--text-lead);
    color: var(--color-ink-secondary);
  }

  .cv__contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
    color: var(--color-ink-secondary);
  }

  .cv__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-5);
  }

  .cv__badge {
    margin-block-start: var(--space-4);
  }

  .cv__section h2 {
    padding-block-end: var(--space-3);
    border-block-end: var(--border-strong);
    margin-block-end: var(--space-5);
  }

  .cv__skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .cv__skills li {
    padding: var(--space-1) var(--space-3);
    border: var(--border-hairline);
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    font-size: var(--text-xs);
    color: var(--color-ink-secondary);
  }

  .cv__role + .cv__role {
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-hairline);
  }

  .cv__role-head h3 {
    font-size: var(--text-h4);
  }

  .cv__role-title {
    color: var(--color-ink-secondary);
    font-weight: 500;
  }

  .cv__period {
    margin-block-start: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }

  .cv__role ul {
    margin-block-start: var(--space-3);
    padding-inline-start: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-ink-secondary);
    font-size: var(--text-small);
  }

  .cv__role li::marker {
    color: var(--color-accent);
  }

  .cv__case-link {
    margin-block-start: var(--space-3);
  }

  .cv__additional {
    display: flex;
    flex-direction: column;
    padding: 0;
    list-style: none;
  }

  .cv__additional li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-block-end: var(--border-hairline);
  }

  .cv__additional-role {
    font-weight: 600;
  }

  .cv__footer-cta {
    padding: var(--space-6);
    border: var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }

  .cv__footer-cta h2 {
    font-size: var(--text-h3);
  }

  /* Print cleanly, like the resume page. */
  @media print {
    .cv__actions,
    .cv__badge,
    .cv__footer-cta,
    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    :global(.cursor-blob) {
      display: none !important;
    }
  }
</style>
