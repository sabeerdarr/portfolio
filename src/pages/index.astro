---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import ProjectCard from '@/components/cards/ProjectCard.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import Callout from '@/components/common/Callout.astro';
import AvailabilityBadge from '@/components/common/AvailabilityBadge.astro';
import { site } from '@/config/site';
import { personSchema, websiteSchema } from '@/utils/schema';

// Featured case studies (max three), ordered by `order`.
const allWork = await getCollection('work', ({ data }) => !data.draft);
const featuredWork = allWork
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const mailto = `mailto:${site.email}?subject=${encodeURIComponent("Let's chat — via sabeerdarr.com")}`;

const valueProps = [
  {
    title: 'Product thinking',
    description:
      'Design decisions framed around user needs and business goals — not just screens. I ask what a feature is for before asking what it looks like.',
  },
  {
    title: 'UX research',
    description:
      'Interviews, usability tests, and analytics reviews sized to the risk of the decision, so the team ships evidence instead of assumptions.',
  },
  {
    title: 'Interaction design',
    description:
      'Flows, states, and edge cases worked through end-to-end — including the empty, error, and loading states that make products feel finished.',
  },
  {
    title: 'Visual design',
    description:
      'Clear hierarchy, accessible contrast, and restrained aesthetics that keep attention on the task rather than the decoration.',
  },
  {
    title: 'Prototyping',
    description:
      'Interactive prototypes at the lowest fidelity that answers the question — from clickable wireframes to high-fidelity flows for testing.',
  },
  {
    title: 'Design systems',
    description:
      'Tokens, components, and documentation that scale design across a team and keep the product consistent as it grows.',
  },
  {
    title: 'Developer collaboration',
    description:
      'Specs, annotations, and ongoing pairing that respect engineering constraints — handoff as a conversation, not a file drop.',
  },
  {
    title: 'Remote communication',
    description:
      'Clear async writing, recorded walkthroughs, and structured critique that keep distributed teams aligned across time zones.',
  },
];

const structuredData = [personSchema(), websiteSchema()];
---

<BaseLayout
  rawTitle={site.seo.defaultTitle}
  description={site.seo.defaultDescription}
  structuredData={structuredData}
>
  <!-- 1 · Hero -->
  <section class="hero">
    <div class="container">
      <p class="hero__badge"><AvailabilityBadge variant="full" /></p>
      <h1 class="hero__title">
        UI/UX designer creating <em>clear, useful</em> digital products.
      </h1>
      <p class="hero__lede">
        I help product teams turn complex requirements into intuitive SaaS and mobile experiences
        through research, interaction design, prototyping, and scalable design systems.
      </p>
      <p class="hero__availability">{site.availability.message}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/work">View case studies</a>
        <a class="btn btn--secondary" href="/#hire-me">Hire me</a>
        <a class="btn btn--ghost" href="/photography">Photography, for fun</a>
      </div>
    </div>
    <div class="hero__rule" aria-hidden="true"></div>
  </section>

  <!-- 2 · Selected work -->
  <section class="section" aria-labelledby="selected-work">
    <div class="container">
      <SectionHeading
        kicker="01 · Selected work"
        title="Case studies, not just screenshots"
        id="selected-work"
      >
        Each project walks through the problem, the decisions, the trade-offs, and what happened
        after launch — because the reasoning matters as much as the result.
        <a slot="action" class="text-link" href="/work">All work</a>
      </SectionHeading>

      {
        featuredWork.length > 0 ? (
          <div class="work-grid">
            {featuredWork.map((project, index) => (
              <ProjectCard
                project={project}
                variant={index === 0 ? 'featured' : 'compact'}
                headingLevel="h3"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            ))}
          </div>
        ) : (
          <Callout variant="placeholder" title="No featured projects yet">
            <p>
              Mark case studies as <code>featured: true</code> in their frontmatter to show them
              here. See CONTENT_GUIDE.md.
            </p>
          </Callout>
        )
      }
    </div>
  </section>

  <!-- 3 · Value proposition -->
  <section class="section section--alt" aria-labelledby="value-heading">
    <div class="container">
      <SectionHeading
        kicker="02 · What I bring"
        title="End-to-end product design, grounded in evidence"
        id="value-heading"
      >
        The craft spans research through delivery. The value is in connecting them: every visual
        decision should trace back to something a user needs or a metric the business watches.
      </SectionHeading>

      <dl class="value-grid">
        {
          valueProps.map((item) => (
            <div class="value-grid__item">
              <dt>{item.title}</dt>
              <dd>{item.description}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 4 · Process -->
  <section class="section" aria-labelledby="process-heading">
    <div class="container">
      <SectionHeading
        kicker="03 · Process"
        title="A process that adapts to the problem"
        id="process-heading"
      >
        These are the activities, not a conveyor belt. A late-stage usability fix doesn't need
        discovery interviews; a new product bet does. The mix depends on the product's stage, risk,
        timeline, and the evidence already available.
      </SectionHeading>
      <ProcessSteps />
    </div>
  </section>

  <!-- 5 · Hire me -->
  <section class="section section--alt" id="hire-me" aria-labelledby="hire-heading">
    <div class="container">
      <div class="hire">
        <p class="kicker">04 · Hire me</p>
        <h2 id="hire-heading">Hiring a product design lead?</h2>
        <p class="hire__lede">
          10+ years designing and scaling AI SaaS, B2B, and mobile products — from problem
          definition and user flows through design systems, developer handoff, and continuous
          improvement. {site.availability.message}
        </p>
        <div class="hire__actions">
          <a class="btn btn--primary" href={site.resumePath} data-event="resume-download" download>
            Download CV
          </a>
          <a class="btn btn--secondary" href={mailto} data-event="hire-email">Let's chat</a>
        </div>
        <p class="hire__email">
          Or write directly: <a href={mailto}>{site.email}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-8);
  }

  .hero__badge {
    margin-block-end: var(--space-5);
  }

  .hero__title {
    font-size: var(--text-display);
    max-width: 16ch;
  }

  .hero__title em {
    font-style: italic;
    color: var(--color-accent);
  }

  .hero__lede {
    margin-block-start: var(--space-5);
    max-width: 44em;
    font-size: var(--text-lead);
    color: var(--color-ink-secondary);
    text-wrap: pretty;
  }

  .hero__availability {
    margin-block-start: var(--space-4);
    font-size: var(--text-small);
    color: var(--color-ink-faint);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .hero__rule {
    margin-block-start: var(--space-8);
    border-block-end: var(--border-hairline);
  }

  .section--alt {
    background-color: var(--color-surface);
    border-block: var(--border-hairline);
  }

  .work-grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .work-grid {
      grid-template-columns: 1fr 1fr;
    }

    /* Featured card spans the full row. */
    .work-grid > :global(.project-card--featured) {
      grid-column: 1 / -1;
    }
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-6) var(--space-7);
    margin: 0;
  }

  .value-grid__item {
    padding-block-start: var(--space-4);
    border-block-start: 2px solid var(--color-ink);
  }

  .value-grid__item dt {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: 600;
  }

  .value-grid__item dd {
    margin: var(--space-2) 0 0;
    font-size: var(--text-small);
    color: var(--color-ink-secondary);
  }

  /* Hire section — anchored from the header CTA and hero. */
  #hire-me {
    scroll-margin-top: 5.5rem;
  }

  .hire {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-7);
    border: var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--color-ink);
    color: var(--color-bg);
  }

  .hire .kicker {
    color: color-mix(in srgb, var(--color-bg) 65%, transparent);
  }

  .hire h2 {
    font-size: var(--text-h1);
    max-width: 18ch;
  }

  .hire__lede {
    max-width: 46em;
    font-size: var(--text-lead);
    opacity: 0.85;
  }

  .hire__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-3);
  }

  /* Buttons sit on the inverted (ink) panel, so swap their colors. */
  .hire .btn--primary {
    background-color: var(--color-accent-strong);
    color: #14110e;
  }

  .hire .btn--primary:hover {
    background-color: var(--color-bg);
    color: var(--color-ink);
  }

  .hire .btn--secondary {
    border-color: color-mix(in srgb, var(--color-bg) 45%, transparent);
    color: var(--color-bg);
  }

  .hire .btn--secondary:hover {
    border-color: var(--color-bg);
    color: var(--color-bg);
  }

  .hire__email {
    font-size: var(--text-small);
    opacity: 0.75;
  }

  .hire__email a {
    color: inherit;
  }
</style>
