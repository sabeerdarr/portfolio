---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/cards/ProjectCard.astro';
import TestimonialCard from '@/components/cards/TestimonialCard.astro';
import SkillsTicker from '@/components/sections/SkillsTicker.astro';
import Callout from '@/components/common/Callout.astro';
import ContactSection from '@/components/sections/ContactSection.astro';
import { site } from '@/config/site';
import { personSchema, websiteSchema } from '@/utils/schema';

// Featured case studies (max three), ordered by `order`. First is the
// full-width feature card, the rest sit in a 2-up row.
const allWork = await getCollection('work', ({ data }) => !data.draft);
const featuredWork = allWork
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const testimonials = [
  {
    quote:
      'Sabeer worked closely with my team to design just what we were looking for in our product. He also brought so many fresh ideas that helped us turn our project into something truly new!',
    name: 'Jon Brown',
    attribution: 'CTO, Groom AI',
    avatar: '/images/testimonials/jon-brown.webp',
    avatarAlt: 'Jon Brown, CTO at Groom AI, in a black shirt and glasses in a bright atrium.',
  },
  {
    quote:
      "We've had the pleasure of working with Sabeer on numerous projects, and he's consistently demonstrated exceptional design skills. His strong work ethic and sense of responsibility make him an invaluable asset to any team. I highly recommend him.",
    name: 'Frank Diaz',
    attribution: 'President and CEO, Pagertec',
    avatar: '/images/testimonials/frank-diaz.webp',
    avatarAlt: 'Frank Diaz, President and CEO of Pagertec, in a black Pagertec polo shirt.',
  },
  {
    quote:
      'I worked with Sabeer on the design of our internal systems at Mastercard Canada. He took the time to understand how our teams operate, and the result was a set of tools that streamlined our processes with banks. He is a talented designer with a strong sense of responsibility, and he brought good ideas to the project. He communicated clearly and delivered on time. I highly recommend him.',
    name: 'Rafique Awan',
    attribution: 'Product Owner, Mastercard CA',
    avatar: '/images/testimonials/rafique-awan.webp',
    avatarAlt: 'Rafique Awan, Product Owner at Mastercard Canada, in a wetsuit on a beach.',
  },
];

const structuredData = [personSchema(), websiteSchema()];
---

<BaseLayout
  rawTitle={site.seo.defaultTitle}
  description={site.seo.defaultDescription}
  structuredData={structuredData}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__text">
      <p class="kicker">{site.location} · Remote</p>
      <h1 class="text-display">Product designer for complex SaaS and AI products</h1>
      <span class="section-rule"></span>
      <p class="hero__lede">10+ years designing and scaling B2B, AI and mobile products.</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--large" href="/work">View case studies</a>
        <a class="btn btn--secondary btn--large" href="/#contact">Get in touch</a>
      </div>
    </div>
    <div class="hero__portrait">
      <img
        src="/images/profile/sabeer-portrait.webp"
        alt="Sabeer Darr, seated, wearing a white linen shirt, in a dark room with diagonal window light behind him."
        width="900"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <SkillsTicker />

  <!-- Selected work -->
  <section class="section" aria-labelledby="selected-work">
    <div class="container">
      <div class="work-heading">
        <h2 id="selected-work">Three products, from problem to shipped</h2>
        <a class="text-link" href="/work">All work</a>
      </div>

      {
        featuredWork.length > 0 ? (
          <div class="work-grid">
            {featuredWork.map((project, index) => (
              <ProjectCard
                project={project}
                variant={index === 0 ? 'featured' : 'compact'}
                headingLevel="h3"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            ))}
          </div>
        ) : (
          <Callout variant="placeholder" title="No featured projects yet">
            <p>
              Mark case studies as <code>featured: true</code> in their frontmatter to show them
              here. See CONTENT_GUIDE.md.
            </p>
          </Callout>
        )
      }
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section" aria-label="Testimonials">
    <div class="container">
      <h2 class="testimonials-heading">What it is like to work with me</h2>
      <div class="testimonials-grid">
        {
          testimonials.map((t) => (
            <TestimonialCard
              quote={t.quote}
              name={t.name}
              attribution={t.attribution}
              avatar={t.avatar}
              avatarAlt={t.avatarAlt}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Choose your path -->
  <section class="path-cards" aria-label="Choose your path">
    <a class="path-card path-card--hiring" href="/about">
      <span class="path-card__motif path-card__motif--circle" aria-hidden="true"></span>
      <span class="path-card__title">Hiring? See my experience and CV</span>
      <span class="path-card__hint">Background, experience and how I work. → /about</span>
    </a>
    <a class="path-card path-card--client" href="/work">
      <span class="path-card__motif path-card__motif--square" aria-hidden="true"></span>
      <span class="path-card__title">Have a project? See how I work</span>
      <span class="path-card__hint">Recent case studies and what I worked on. → /work</span>
    </a>
  </section>

  <ContactSection />
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    border-block-end: var(--border-hairline) solid var(--color-border);
  }

  .hero__text {
    flex: 1 1 26rem;
    min-width: 0;
    padding: clamp(2.25rem, 5vw, 5.5rem) clamp(1.25rem, 4vw, 4rem);
    border-inline-end: var(--border-hairline) solid var(--color-border);
  }

  .hero__text .text-display {
    max-width: 16ch;
  }

  .hero .section-rule {
    margin-block: var(--space-6);
  }

  .hero__lede {
    max-width: 44em;
    font-size: var(--text-lead);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-7);
  }

  .hero__portrait {
    position: relative;
    flex: 1 1 18rem;
    min-width: 0;
    min-height: 21.25rem;
    background-color: var(--color-accent-solid);
    overflow: hidden;
  }

  .hero__portrait img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 14%;
  }

  .work-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-block-end: var(--space-8);
  }

  .work-heading h2 {
    flex: 1 1 20rem;
  }

  .work-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 40rem) {
    .work-grid {
      grid-template-columns: 1fr 1fr;
    }

    /* Featured card spans the full row. */
    .work-grid > :global(.project-card--featured) {
      grid-column: 1 / -1;
    }
  }

  .testimonials-heading {
    margin-block-end: var(--space-7);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
  }

  .path-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .path-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(1.75rem, 3.6cqw, 4rem) clamp(1.25rem, 3.4cqw, 3.5rem);
    color: var(--color-text);
    text-decoration: none;
    border-block-end: var(--border-hairline) solid var(--color-border);
  }

  @media (min-width: 40rem) {
    .path-card--hiring {
      border-inline-end: var(--border-hairline) solid var(--color-border);
    }
  }

  .path-card:hover {
    background-color: var(--color-surface);
    text-decoration: none;
  }

  .path-card__motif {
    display: block;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    background-color: var(--color-accent-solid);
  }

  .path-card__motif--circle {
    border-radius: var(--radius-full);
  }

  .path-card__motif--square {
    background-color: var(--color-text);
  }

  .path-card__title {
    font-size: var(--text-h3);
    font-weight: 700;
    font-variation-settings: 'wdth' 108;
    line-height: var(--leading-snug);
    letter-spacing: -0.02em;
  }

  .path-card__hint {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
