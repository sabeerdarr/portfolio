---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Callout from '@/components/common/Callout.astro';
import { photos } from '@/data/photography';
import { breadcrumbSchema } from '@/utils/schema';
import { site } from '@/config/site';

/**
 * Photography — a hobby page, deliberately lighter in tone than the
 * rest of the site. Gallery entries come from src/data/photography.ts;
 * the layout is a JS-free masonry-style column grid.
 */
const structuredData = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Photography', path: '/photography' },
  ]),
];

const hasRealPhotos = photos.some((p) => !p.src.includes('placeholder'));
---

<BaseLayout
  title="Photography"
  description="Photographs by Sabeer Darr — a hobby, not a job. Shots I liked enough to keep."
  structuredData={structuredData}
>
  <div class="container">
    <header class="page-hero">
      <p class="kicker">Photography</p>
      <h1>Off duty, behind a lens</h1>
      <p class="page-hero__lede">
        Design is the job; this is the hobby. No client, no brief, no design system — just shots I
        liked enough to keep. Expect an unedited mix of places, light, and whatever caught my eye.
      </p>
    </header>

    <section class="section" aria-label="Photo gallery">
      <ul class="gallery" role="list">
        {
          photos.map((photo) => (
            <li class:list={['gallery__item', `gallery__item--${photo.orientation}`]}>
              <figure>
                <img
                  src={photo.src}
                  alt={photo.alt}
                  width={photo.orientation === 'portrait' ? 900 : 1440}
                  height={photo.orientation === 'portrait' ? 1200 : 960}
                  loading="lazy"
                  decoding="async"
                />
                {photo.caption && <figcaption>{photo.caption}</figcaption>}
              </figure>
            </li>
          ))
        }
      </ul>
    </section>

    <aside class="gallery-footer">
      <p>
        Like one of these, or shoot yourself? I'm always happy to talk photos —
        <a href={`mailto:${site.email}?subject=${encodeURIComponent('Photography')}`}>say hello</a>.
        (For design work, head to <a href="/work">Work</a>.)
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-8) var(--space-6);
    border-block-end: var(--border-hairline);
  }

  .page-hero h1 {
    margin-block-start: var(--space-4);
  }

  .page-hero__lede {
    margin-block-start: var(--space-4);
    max-width: 46em;
    font-size: var(--text-lead);
    color: var(--color-ink-secondary);
  }

  .gallery-note {
    margin-block-start: var(--space-6);
  }

  /* JS-free masonry: CSS columns. Items keep natural aspect ratios. */
  .gallery {
    columns: 1;
    column-gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 30rem) {
    .gallery {
      columns: 2;
    }
  }

  @media (min-width: 64rem) {
    .gallery {
      columns: 3;
    }
  }

  .gallery__item {
    break-inside: avoid;
    margin-block-end: var(--space-5);
  }

  .gallery__item figure {
    margin: 0;
  }

  .gallery__item img {
    inline-size: 100%;
    block-size: auto;
    border: var(--border-hairline);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .gallery__item:hover img {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .gallery__item figcaption {
    margin-block-start: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.04em;
    color: var(--color-ink-faint);
  }

  .gallery-footer {
    margin-block: var(--space-6) var(--space-8);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-hairline);
    color: var(--color-ink-secondary);
    font-size: var(--text-small);
    max-width: 46em;
  }
</style>
