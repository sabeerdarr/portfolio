---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import ArticleCard from '@/components/cards/ArticleCard.astro';
import NewsletterForm from '@/components/forms/NewsletterForm.astro';
import Callout from '@/components/common/Callout.astro';
import { slugify } from '@/utils/format';
import { blogSchema, breadcrumbSchema } from '@/utils/schema';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf()
);

const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured?.id);

// Only show categories that actually have published posts.
const categories = [...new Set(posts.map((p) => p.data.category))].sort();

const structuredData = [
  blogSchema(),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Writing', path: '/writing' },
  ]),
];
---

<BaseLayout
  title="Writing"
  description="Articles on UX strategy, product design, design systems, and remote collaboration by Sabeer Darr."
  structuredData={structuredData}
>
  <div class="container">
    <header class="page-hero">
      <p class="kicker">Writing</p>
      <h1>Practical notes on designing useful products</h1>
      <p class="page-hero__lede">
        Case-study breakdowns, UX process frameworks, and lessons from working with product teams
        remotely. Written to be useful, not to fill a content calendar.
      </p>
      {
        categories.length > 0 && (
          <nav class="page-hero__categories" aria-label="Article categories">
            {categories.map((category) => (
              <a class="category-chip" href={`/writing/category/${slugify(category)}/`}>
                {category}
              </a>
            ))}
          </nav>
        )
      }
    </header>

    {
      posts.length === 0 ? (
        <div class="section">
          <Callout variant="note" title="Articles coming soon">
            <p>The first articles are being written and will be published here.</p>
          </Callout>
        </div>
      ) : (
        <>
          {featured && (
            <section class="section" aria-labelledby="featured-article-heading">
              <SectionHeading kicker="Featured" title="Start here" id="featured-article-heading" />
              <div class="featured-article">
                <ArticleCard article={featured} headingLevel="h3" showImage />
              </div>
            </section>
          )}

          {rest.length > 0 && (
            <section class="section" aria-labelledby="all-articles-heading">
              <SectionHeading kicker="Archive" title="All articles" id="all-articles-heading" />
              <div class="articles-grid">
                {rest.map((article) => (
                  <ArticleCard article={article} headingLevel="h3" />
                ))}
              </div>
            </section>
          )}
        </>
      )
    }

    <div class="section">
      <NewsletterForm />
      <p class="rss-note">
        Prefer a feed reader? <a href="/rss.xml">Subscribe via RSS</a>.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-8) var(--space-6);
    border-block-end: var(--border-hairline) solid var(--color-border);
  }

  .page-hero h1 {
    margin-block-start: var(--space-4);
  }

  .page-hero__lede {
    margin-block-start: var(--space-4);
    max-width: 46em;
    font-size: var(--text-lead);
    color: var(--color-text-muted);
  }

  .page-hero__categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-5);
  }

  .category-chip {
    padding: var(--space-1) var(--space-3);
    border: var(--border-hairline) solid var(--color-border);
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .category-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .featured-article {
    max-width: 52rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-6);
  }

  .rss-note {
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
