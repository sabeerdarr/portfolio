---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/cards/ArticleCard.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import { slugify } from '@/utils/format';
import { breadcrumbSchema } from '@/utils/schema';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf()
  );

  // Only generate archives for categories that have published posts.
  const categories = [...new Set(posts.map((p) => p.data.category))];

  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: {
      category,
      posts: posts.filter((p) => p.data.category === category),
    },
  }));
}

interface Props {
  category: string;
  posts: CollectionEntry<'blog'>[];
}

const { category, posts } = Astro.props;

const structuredData = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Writing', path: '/writing' },
    { name: category, path: `/writing/category/${slugify(category)}/` },
  ]),
];
---

<BaseLayout
  title={`${category} articles`}
  description={`Articles about ${category.toLowerCase()} by Sabeer Darr.`}
  structuredData={structuredData}
>
  <div class="container">
    <header class="page-hero">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Writing', href: '/writing' },
          { label: category },
        ]}
      />
      <p class="kicker">Category</p>
      <h1>{category}</h1>
      <p class="page-hero__lede">
        {posts.length}
        {posts.length === 1 ? 'article' : 'articles'} in this category.
        <a href="/writing">Browse all writing</a>.
      </p>
    </header>

    <section class="section">
      <div class="articles-grid">
        {posts.map((article) => <ArticleCard article={article} headingLevel="h2" />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-8) var(--space-6);
    border-block-end: var(--border-hairline) solid var(--color-border);
  }

  .page-hero .kicker {
    margin-block-start: var(--space-6);
  }

  .page-hero h1 {
    margin-block-start: var(--space-3);
  }

  .page-hero__lede {
    margin-block-start: var(--space-4);
    color: var(--color-text-muted);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-6);
  }
</style>
