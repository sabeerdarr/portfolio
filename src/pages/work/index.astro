---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TestimonialCard from '@/components/cards/TestimonialCard.astro';
import Callout from '@/components/common/Callout.astro';
import { breadcrumbSchema } from '@/utils/schema';

const FILTER_CATEGORIES = [
  'AI',
  'Web app / SaaS',
  'Mobile apps',
  'Web design',
  'UX research',
  'Design systems',
] as const;

const allWork = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const filters = [
  { value: 'all', label: 'All work', count: allWork.length },
  ...FILTER_CATEGORIES.map((category) => ({
    value: category,
    label: category,
    count: allWork.filter((p) => (p.data.categories ?? []).includes(category)).length,
  })),
].filter((f) => f.value === 'all' || f.count > 0);

const structuredData = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Work', path: '/work' },
  ]),
];
---

<BaseLayout
  title="Work"
  description="UI/UX and product design case studies by Sabeer Darr — SaaS onboarding, mobile fintech, and design systems, each with the reasoning behind the outcome."
  structuredData={structuredData}
>
  <div class="container">
    <header class="page-hero">
      <h1>Work</h1>
      <span class="section-rule"></span>
      <p class="page-hero__lede">
        Products where I owned design end to end: the problem, the decisions, the trade-offs and
        what happened after launch.
      </p>
    </header>

    {
      allWork.length === 0 ? (
        <Callout variant="placeholder" title="No case studies published">
          <p>Add case-study files to src/content/work/ — see CONTENT_GUIDE.md.</p>
        </Callout>
      ) : (
        <section class="section" aria-label="Case studies">
          {filters.length > 1 && (
            <div
              class="chip-group"
              role="group"
              aria-label="Filter work by category"
              data-work-filters
            >
              {filters.map((filter, index) => (
                <button
                  type="button"
                  class="chip"
                  data-filter={filter.value}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  {filter.label}
                  <span class="chip__count">{filter.count}</span>
                </button>
              ))}
            </div>
          )}

          <div class="work-list" data-work-list>
            {allWork.map((project) => {
              const categories = project.data.categories ?? project.data.category;
              return (
                <article class="work-row" data-cardstroke data-categories={categories.join('|')}>
                  <a class="work-row__link" href={`/work/${project.id}/`}>
                    <img
                      class="work-row__image"
                      src={project.data.coverImage}
                      alt={project.data.coverAlt}
                      width="1600"
                      height="1000"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="work-row__body">
                      <p class="work-row__tagline">{categories.join(' · ')}</p>
                      <h2 class="work-row__title">{project.data.title}</h2>
                      <p class="work-row__summary">{project.data.summary}</p>
                      <p class="work-row__cta" aria-hidden="true">
                        <span class="text-link">Read the case study</span>
                      </p>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>

          <p class="work-empty" data-work-empty hidden>
            No case studies match that filter yet.
          </p>
        </section>
      )
    }

    <section class="work-testimonial" aria-label="Testimonial">
      <div class="container container--narrow">
        <TestimonialCard
          variant="feature"
          quote="We've had the pleasure of working with Sabeer on numerous projects, and he's consistently demonstrated exceptional design skills. His strong work ethic and sense of responsibility make him an invaluable asset to any team. I highly recommend him."
          name="Frank Diaz"
          attribution="President and CEO, Pagertec"
          avatar="/images/testimonials/frank-diaz.jpg"
          avatarAlt="Frank Diaz, President and CEO of Pagertec, in a black Pagertec polo shirt."
        />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-8) var(--space-6);
    border-block-end: var(--border-hairline) solid var(--color-border);
  }

  .page-hero .section-rule {
    margin-block: var(--space-6);
  }

  .page-hero__lede {
    max-width: 46em;
    font-size: var(--text-lead);
    color: var(--color-text-muted);
  }

  .chip-group {
    padding-block-end: clamp(1.5rem, 3cqw, 2.5rem);
    border-block-end: var(--border-hairline) solid var(--color-border);
  }

  .work-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: clamp(1.5rem, 3cqw, 2.5rem);
  }

  .work-row {
    border: var(--border-hairline) solid var(--color-border);
    background-color: var(--color-surface);
    transition: border-color var(--duration-hover) var(--ease);
  }

  @media (hover: hover) {
    .work-row:hover {
      animation: cardStroke var(--duration-card-loop) var(--ease) infinite;
    }
  }

  @keyframes cardStroke {
    0% {
      border-color: var(--color-brand-mark);
    }
    33% {
      border-color: var(--color-accent-solid);
    }
    66% {
      border-color: var(--color-brand-orange);
    }
    100% {
      border-color: var(--color-brand-mark);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-row:hover {
      animation: none;
      border-color: var(--color-accent-solid);
    }
  }

  .work-row[hidden] {
    display: none;
  }

  .work-row__link {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    color: inherit;
    text-decoration: none;
  }

  .work-row__image {
    inline-size: 100%;
    block-size: 100%;
    min-height: 15rem;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .work-row__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
    padding: clamp(1.5rem, 3cqw, 3rem);
  }

  .work-row__tagline {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-accent);
  }

  .work-row__title {
    font-size: var(--text-h3);
  }

  .work-row__summary {
    max-width: 56ch;
    color: var(--color-text-muted);
  }

  .work-row__cta {
    margin-block-start: var(--space-1);
  }

  .work-empty {
    padding-block: var(--space-7);
    text-align: center;
    color: var(--color-text-muted);
  }

  .work-testimonial {
    margin-block: var(--space-8);
    padding-block: clamp(2rem, 4cqw, 4.5rem);
    border-block-start: var(--border-heavy) solid var(--color-accent-solid);
    background-color: var(--color-bg-inset);
  }
</style>

<script>
  const group = document.querySelector<HTMLElement>('[data-work-filters]');
  const list = document.querySelector<HTMLElement>('[data-work-list]');
  const empty = document.querySelector<HTMLElement>('[data-work-empty]');
  if (group && list) {
    const chips = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const rows = Array.from(list.querySelectorAll<HTMLElement>('[data-categories]'));

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
        chip.setAttribute('aria-pressed', 'true');

        const value = chip.dataset.filter ?? 'all';
        let visibleCount = 0;
        rows.forEach((row) => {
          const categories = (row.dataset.categories ?? '').split('|');
          const matches = value === 'all' || categories.includes(value);
          row.hidden = !matches;
          if (matches) visibleCount += 1;
        });
        if (empty) empty.hidden = visibleCount > 0;
      });
    });
  }
</script>
