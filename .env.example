# ------------------------------------------------------------------
# Environment variables for sabeerdarr.com
#
# Copy this file to `.env` for local development. For production
# builds on GitHub Actions, add these as repository secrets or
# variables and expose them in .github/workflows/deploy.yml.
#
# Every variable is optional. The site builds and works without any
# of them — the related features simply stay disabled and show their
# graceful fallbacks instead.
# ------------------------------------------------------------------

# Formspree form IDs (the short ID from your form's endpoint URL,
# e.g. for https://formspree.io/f/abcd1234 the ID is "abcd1234").
# Create separate forms at https://formspree.io so employment,
# freelance, and homepage enquiries stay organised.
PUBLIC_FORMSPREE_EMPLOYMENT_FORM_ID=
PUBLIC_FORMSPREE_FREELANCE_FORM_ID=

# Homepage #contact form (2026 redesign).
PUBLIC_FORMSPREE_CONTACT_FORM_ID=

# Newsletter provider form action URL (provider-neutral).
# Examples:
#   Buttondown:  https://buttondown.com/api/emails/embed-subscribe/YOUR_USERNAME
#   Formspree:   https://formspree.io/f/YOUR_FORM_ID
# Leave empty to show an email-based subscribe fallback instead.
PUBLIC_NEWSLETTER_ACTION_URL=

# Cloudflare Web Analytics beacon token.
# Found in the Cloudflare dashboard under Web Analytics > your site.
# Analytics loads ONLY in production builds and ONLY when this is set.
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
